# =============================================================================
# Nativo 환경 변수 예시 — 실제 값은 .env.local 에 넣고 절대 커밋하지 않는다.
# 설계서 7.1 API 키 관리 원칙을 따른다.
# =============================================================================

# --- Supabase (Database / Auth / Storage) ---
# anon key 는 클라이언트 노출 가능 (NEXT_PUBLIC_ 허용). RLS로 보호됨.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key 는 RLS를 우회한다 → 서버 전용. NEXT_PUBLIC_ 접두사 절대 금지.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI (Phase 4 롤플레이 / Phase 5 번역 평가 / 일기 첨삭 / Whisper) ---
# 서버 전용. API Route 에서만 사용.
OPENAI_API_KEY=sk-...

# --- Google Cloud TTS (전 Phase 발음 듣기) ---
# 서버 전용. API Route 에서 프록시하여 합성 오디오만 클라이언트로 전달.
GOOGLE_TTS_API_KEY=your-google-tts-key
